DATABASE_URL=postgresql+asyncpg://moderator:moderator@db:5432/moderator
ANTHROPIC_API_KEY=sk-ant-...
ADMIN_SECRET=change-me-in-production
APP_ENV=development
LOG_LEVEL=info

# Auth / JWT — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_SECRET=
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRY_DAYS=30

# SMTP (optional — OTP is logged to stdout when not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@mod.yourdomain.com

# Shown in CLI provider auth guidance
SERVICE_URL=https://mod.yourdomain.com
